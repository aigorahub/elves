   382	    if data.get("schema_version") != PREWALK_SCHEMA_VERSION:
   383	        raise ValidationIssue(code, "Unsupported prewalk TODO schema", path="schema_version")
   384	    if data.get("run_id") != run_id:
   385	        raise ValidationIssue(code, "Prewalk TODO run identity does not match", path="run_id")
   386	    if data.get("session_id") != session_id:
   387	        raise ValidationIssue(code, "Prewalk TODO session identity does not match", path="session_id")
