   202	# The effective model is B. The top-level type is `item.completed`, which is what
   203	# `_PROVIDER_ERROR_EVENT_TYPES` reads, so this is not a provider failure and must
   204	# not become one.
   205	_CODEX_RESUMED_MODEL_RE = re.compile(
   206	    r"recorded with model `([^`]{1,128})` but is resuming with `([^`]{1,128})`"
   207	)
