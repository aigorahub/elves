   700	def packet_digest(path: Path) -> str:
   701	    target = path.resolve(strict=True)
   702	    metadata = target.stat()
   703	    if path.is_symlink() or not target.is_file() or metadata.st_size > PREWALK_PACKET_MAX_BYTES:
   704	        raise ValidationIssue("prewalk_packet_replayed", "Worker packet must be one bounded regular file", path=str(target))
   705	    return hashlib.sha256(target.read_bytes()).hexdigest()
