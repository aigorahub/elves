   709	def regenerate_digest_file(path: Path) -> dict[str, Any]:
   710	    lock = _lock_path(path)
   711	    with open(lock, "w", encoding="utf-8") as lock_handle:
   712	        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
   713	        try:
   714	            _, doc = _read_doc(path)
   715	            lines = ensure_digest_block(list(doc.lines))
   716	            lines = _regenerate_digest(lines)
   717	            _atomic_write(path, _serialize(lines, doc.trailing_newline))
   718	            active = sum(1 for e in parse_text(_serialize(lines, True)).entries.values() if not e.retired)
   719	            return {"digest_entries": min(active, DIGEST_MAX_ENTRIES), "active": active}
   720	        finally:
   721	            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
