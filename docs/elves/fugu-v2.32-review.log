   714	            state.status = "failed"
   715	            state.blocker = "supervisor exited while its process group remains alive"
   716	            state.next_action = "driver_wake_error"
   717	        elif supervised_pids:
   718	            state.status = "failed"
   719	            state.blocker = "supervisor exited while recursively supervised descendants remain alive"
   720	            state.next_action = "driver_wake_error"
   721	        elif state.launched_at:
   722	            state.status = "failed"
   723	            state.blocker = "supervisor disappeared without a validated exit record"
   724	            state.next_action = "driver_wake_error"
   725	        elif last_type == "blocked":
   726	            state.status = "blocked"
   727	            state.next_action = "driver_wake_blocker"
   728	        elif saw_run_complete_event:
   729	            state.status = "failed"
   730	            state.blocker = "run_complete event without validated complete report and exit"
   731	            state.next_action = "driver_wake_error"
   732	        else:
   733	            # A genuinely prepared-but-not-launched session remains pending.
   734	            state.status = "pending"
   735	            state.next_action = "launch"
   736
   737	    # Planned checkpoints gate both an active run and a cleanly completed
   738	    # provider. This closes the race where the worker emits a checkpoint and a
   739	    # complete report before the driver's next poll. Error, blocker, stale, and
   740	    # safety outcomes still outrank the checkpoint wake path.
   741	    if (
   742	        state.status in {"healthy", "complete"}
   743	        and unacknowledged_high_risk_checkpoints
   744	    ):
   745	        pending = state.pending_high_risk_checkpoint
   746	        if pending not in unacknowledged_high_risk_checkpoints:
   747	            pending = unacknowledged_high_risk_checkpoints[0]
   748	        state.pending_high_risk_checkpoint = pending
   749	        state.next_action = "driver_wake_high_risk_checkpoint"
   750	    elif state.status == "complete":
   751	        state.pending_high_risk_checkpoint = None
   752	        if (
   753	            state.next_action == "driver_wake_high_risk_checkpoint"
   754	            or initial_next_action == "driver_wake_high_risk_checkpoint"
   755	        ):
   756	            state.next_action = "final_readiness"
   757	    elif state.status != "healthy":
   758	        state.pending_high_risk_checkpoint = None
   759
   760	    # A worker-discovered material contract change is an explicit hand-back,
   761	    # not ordinary progress. Keep the process/result intact and wake the driver
   762	    # so the changed scope or assumption can be resolved before readiness.
   763	    if state.status in {"healthy", "complete"} and observed_material_change:
