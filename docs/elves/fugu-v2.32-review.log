  6179	            "event_signature": signature,
  6180	            "event_summary": {
  6181	                "count": 1,
  6182	                "last_type": "batch_started",
  6183	                "saw_run_complete": False,
  6184	                "high_risk_checkpoints": [],
  6185	                "material_scope_or_assumption_change": False,
  6186	            },
