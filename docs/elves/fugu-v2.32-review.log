   404	def ensure_digest_block(lines: list[str]) -> list[str]:
   405	    """Insert an empty digest section after the first `---` if none exists."""
   406
   407	    if DIGEST_BEGIN in lines:
   408	        return lines
   409	    try:
   410	        anchor = lines.index("---") + 1
   411	    except ValueError:
   412	        # aigorahub/elves#249: no separator — place the digest right after the
   413	        # title/intro block (before the first `##` section) instead of at EOF.
   414	        anchor = next(
   415	            (i for i, line in enumerate(lines) if line.startswith("## ")),
   416	            len(lines),
   417	        )
   418	    block = ["", f"## {DIGEST_HEADING}", "", DIGEST_BEGIN, DIGEST_END]
   419	    return lines[:anchor] + block + lines[anchor:]
