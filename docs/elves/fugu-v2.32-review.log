   210	def _observed_route_from_event(
   211	    event: dict[str, Any], host: str | None
   212	) -> ObservedRoute | None:
   213	    """Return the effective route a host named for itself, or None.
   214
   215	    None means "this host published nothing here". That is not evidence an override
   216	    was ignored — only a positive, host-published naming of the model actually in use
   217	    counts as evidence either way.
   218	    """
   219	    if (host or "").strip().lower().replace("-code", "") != "codex":
   220	        return None
   221	    if event.get("type") != "item.completed":
   222	        return None
   223	    item = event.get("item")
   224	    if not isinstance(item, dict) or item.get("type") != "error":
   225	        return None
   226	    message = item.get("message")
   227	    if not isinstance(message, str):
   228	        return None
   229	    match = _CODEX_RESUMED_MODEL_RE.search(message)
   230	    if match is None:
   231	        return None
   232	    return ObservedRoute(model=match.group(2), source="codex_resume_model_notice")
