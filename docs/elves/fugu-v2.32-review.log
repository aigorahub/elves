   442	def validate_checkpoint_artifact(
   443	    data: Mapping[str, Any],
   444	    *,
   445	    run_id: str,
   446	    session_id: str,
   447	    todo: Mapping[str, Any],
   448	) -> dict[str, Any]:
   449	    """Validate a first-edit or task-complete checkpoint against its TODO."""
   450	    code = "prewalk_checkpoint_invalid"
   451	    if data.get("schema_version") != PREWALK_SCHEMA_VERSION:
   452	        raise ValidationIssue(code, "Unsupported prewalk checkpoint schema", path="schema_version")
   453	    if data.get("run_id") != run_id or data.get("session_id") != session_id:
   454	        raise ValidationIssue(code, "Prewalk checkpoint identity does not match the run/session", path="session_id")
   455	    kind = data.get("kind")
   456	    if kind not in {"first_meaningful_edit", "task_complete"}:
   457	        raise ValidationIssue(code, "Unknown prewalk checkpoint kind", path="kind")
   458	    todo_id = _required_text(data.get("todo_id"), path="todo_id", code=code, max_chars=16)
   459	    items = {str(item.get("id")): item for item in todo.get("items", []) if isinstance(item, Mapping)}
   460	    if todo_id not in items:
   461	        raise ValidationIssue(code, "Checkpoint references a missing TODO item", path="todo_id")
   462	    changed = data.get("changed_paths")
   463	    if not isinstance(changed, list) or not changed or len(changed) > 100:
   464	        raise ValidationIssue(code, "Checkpoint changed_paths must be a non-empty bounded list", path="changed_paths")
   465	    normalized_paths = [
   466	        _safe_repo_path(value, path=f"changed_paths[{index}]", code=code)
   467	        for index, value in enumerate(changed)
   468	    ]
   469	    if len(set(normalized_paths)) != len(normalized_paths):
   470	        raise ValidationIssue(code, "Checkpoint changed_paths must be unique", path="changed_paths")
   471	    summary = _normalized_summary(data.get("summary"), path="summary", code=code)
   472	    # aigorahub/elves#260: an absent or null list means "no validation was run" and is
   473	    # honest on its own. Coercing a prose `validation` string into a command record
   474	    # would invent an exit code the guide never observed, so malformed entries stay fatal.
   475	    attempts = data.get("validation_attempted")
   476	    if attempts is None:
   477	        attempts = []
   478	    if not isinstance(attempts, list) or len(attempts) > PREWALK_MAX_VALIDATION_ATTEMPTS:
   479	        raise ValidationIssue(code, "validation_attempted must be a bounded list", path="validation_attempted")
   480	    normalized_attempts: list[dict[str, Any]] = []
   481	    for index, raw in enumerate(attempts):
   482	        if not isinstance(raw, Mapping):
   483	            raise ValidationIssue(code, "Validation attempts must be objects", path=f"validation_attempted[{index}]")
   484	        exit_code = raw.get("exit_code")
   485	        if not isinstance(exit_code, int) or isinstance(exit_code, bool):
   486	            raise ValidationIssue(code, "Validation attempt exit_code must be an integer", path=f"validation_attempted[{index}].exit_code")
   487	        normalized_attempts.append(
   488	            {
   489	                "command": _required_text(raw.get("command"), path=f"validation_attempted[{index}].command", code=code, max_chars=1_000),
   490	                "exit_code": exit_code,
   491	            }
   492	        )
   493	    if data.get("ready_for_execution_model") is not True:
   494	        raise ValidationIssue(code, "Checkpoint must explicitly declare readiness", path="ready_for_execution_model")
   495	    _rfc3339(data.get("created_at"), path="created_at", code=code)
   496	    if kind == "first_meaningful_edit" and items[todo_id].get("status") == "pending":
   497	        raise ValidationIssue(code, "First-edit TODO item may not remain pending", path="todo_id")
   498	    if kind == "task_complete" and any(item.get("status") != "complete" for item in items.values()):
   499	        raise ValidationIssue(code, "Task-complete checkpoint requires every TODO item complete", path="kind")
   500	    result = dict(data)
   501	    result["changed_paths"] = normalized_paths
   502	    result["summary"] = summary
   503	    result["validation_attempted"] = normalized_attempts
