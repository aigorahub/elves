   401	    seen: set[str] = set()
   402	    for index, raw in enumerate(items, start=1):
   403	        path = f"items[{index - 1}]"
   404	        if not isinstance(raw, Mapping):
   405	            raise ValidationIssue(code, "Prewalk TODO items must be objects", path=path)
   406	        item_id = _required_text(raw.get("id"), path=f"{path}.id", code=code, max_chars=16)
   407	        match = _TODO_ID_RE.fullmatch(item_id)
   408	        if match is None or int(match.group(1)) != index or item_id in seen:
   409	            raise ValidationIssue(code, "Prewalk TODO ids must be unique ordered PW-01 identifiers", path=f"{path}.id")
   410	        seen.add(item_id)
   411	        status_value = raw.get("status")
   412	        if status_value not in {"pending", "in_progress", "complete"}:
   413	            raise ValidationIssue(code, "Invalid prewalk TODO status", path=f"{path}.status")
   414	        if status_value == "in_progress":
   415	            active += 1
   416	        normalized.append(
   417	            {
   418	                "id": item_id,
   419	                "description": _required_text(raw.get("description"), path=f"{path}.description", code=code),
   420	                "acceptance": _required_text(raw.get("acceptance"), path=f"{path}.acceptance", code=code),
   421	                "validation": _required_text(raw.get("validation"), path=f"{path}.validation", code=code),
   422	                "status": str(status_value),
   423	            }
   424	        )
   425	    if active > 1:
   426	        raise ValidationIssue(code, "At most one prewalk TODO item may be in progress", path="items")
