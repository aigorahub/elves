   585	                "## Repo Conventions\n\n- [L1] keep me (evidence: a)\n\n"
   586	                "## Retired Learnings\n\n- [L9] old -> retired because done\n",
   587	                encoding="utf-8",
   588	            )
   589	            ll.apply_edits(
   590	                path,
   591	                [{"action": "update", "id": "L1", "text": "keep me edited", "reason": "r"}],
   592	            )
   593	            # Cooperating drift: the recorded body coordinate now lands under
   594	            # Retired Learnings, immediately below a forged in-digest heading
