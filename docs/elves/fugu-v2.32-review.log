   258	def _git_write_roots(worktree: Path) -> tuple[str, ...]:
   259	    """Return the least-privilege Git roots needed to commit in a linked worktree.
   260
   261	    A linked checkout stores its index and HEAD under ``.git/worktrees`` while
   262	    objects and branch refs live in the common repository. Granting the common
   263	    ``.git`` directory would also grant config, hooks, tags, and protected refs.
   264	    Keep the write surface to the linked-worktree metadata, object store, and
   265	    the parent directories of the exact feature ref and its reflog. Terminal
   630	            close_fds=True,
   631	            start_new_session=True,
   632	        )
   633	        assert child.stdout is not None and child.stderr is not None
   634	        selector = selectors.DefaultSelector()
   635	        selector.register(child.stdout, selectors.EVENT_READ, "stdout")
   636	        selector.register(child.stderr, selectors.EVENT_READ, "stderr")
   637	        chunks: dict[str, bytearray] = {
   638	            "stdout": bytearray(),
   639	            "stderr": bytearray(),
   640	        }
   641	        deadline = time.monotonic() + timeout_seconds
   642	        timed_out = False
   643	        output_limit_exceeded = False
   644	        while selector.get_map():
   645	            remaining = deadline - time.monotonic()
   646	            if remaining <= 0:
   647	                timed_out = True
   648	                _terminate_canary_process(child)
   649	                break
   650	            events = selector.select(timeout=min(0.2, remaining))
   651	            for key, _ in events:
   652	                data = os.read(key.fileobj.fileno(), 8192)
   653	                if not data:
   654	                    selector.unregister(key.fileobj)
   655	                    continue
   656	                target = chunks[str(key.data)]
   657	                if (
   658	                    len(chunks["stdout"])
   659	                    + len(chunks["stderr"])
   660	                    + len(data)
   661	                    > PREWALK_QUALIFICATION_OUTPUT_MAX_BYTES
   662	                ):
   663	                    output_limit_exceeded = True
   664	                    _terminate_canary_process(child)
   665	                    break
   666	                target.extend(data)
   667	            if output_limit_exceeded:
   668	                break
   669	        if child.poll() is None:
   670	            _terminate_canary_process(child)
   671	        exit_code = child.wait()
   672	        stdout = chunks["stdout"].decode("utf-8", errors="replace")
   673	        stderr = chunks["stderr"].decode("utf-8", errors="replace")
   674	        observed: list[str] = []
   675	        provider_event_count = 0
   676	        observed_route = ObservedRoute()
   677	        for line in stdout.splitlines():
   678	            event = _parse_provider_event(line)
   679	            if event is None:
   680	                continue
   681	            provider_event_count += 1
   682	            session_id = _provider_session_id_from_event(event, host=spec.host)
   683	            if session_id and session_id not in observed:
   684	                observed.append(session_id)
   685	            route = _observed_route_from_event(event, spec.host)
   686	            if route is not None:
   687	                # Last naming wins: a host that announces the route more than once
   688	                # is describing the same turn, and the final word is what ran.
   689	                observed_route = route
   690	        return PrewalkQualificationResult(
   691	            exit_code=(
   692	                124
   693	                if timed_out
   694	                else 125
   695	                if output_limit_exceeded
   696	                else exit_code
   697	            ),
   698	            stdout=stdout,
   699	            stderr_tail=stderr[-_NATIVE_WORKER_STDERR_TAIL_CHARS:],
   700	            observed_session_ids=tuple(observed),
   701	            provider_event_count=provider_event_count,
   702	            timed_out=timed_out,
   703	            output_limit_exceeded=output_limit_exceeded,
   704	            observed_route=observed_route,
   705	        )
   706	    finally:
   707	        if selector is not None:
   708	            selector.close()
   709	        if child is not None:
   710	            if child.stdout is not None:
   711	                child.stdout.close()
   712	            if child.stderr is not None:
   713	                child.stderr.close()
   714	        stdin_handle.close()
   715	        if prompt_path is not None:
   716	            prompt_path.unlink(missing_ok=True)
