   724	def migrate_file(path: Path) -> dict[str, Any]:
   725	    """Assign ids to freehand dated bullets under active category headings."""
   726
   727	    lock = _lock_path(path)
   728	    with open(lock, "w", encoding="utf-8") as lock_handle:
   729	        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
   730	        try:
   731	            _, doc = _read_doc(path)
   732	            lines = list(doc.lines)
   733	            next_id = max(doc.entries, default=0) + 1
   734	            assigned = 0
   735	            current_section = ""
   736	            for index, line in enumerate(lines):
   737	                heading = HEADING_RE.match(line)
   738	                if heading:
   739	                    current_section = heading.group(1)
   740	                    continue
   741	                if current_section in META_HEADINGS or not current_section:
   742	                    continue
   743	                if ENTRY_RE.match(line):
   744	                    continue
   745	                if FREEHAND_BULLET_RE.match(line):
   746	                    lines[index] = f"- [L{next_id}] {line[2:]}"
   747	                    next_id += 1
   748	                    assigned += 1
   749	            if assigned:
   750	                lines = _regenerate_digest(lines)
   751	                _atomic_write(path, _serialize(lines, doc.trailing_newline))
   752	            return {"assigned": assigned, "next_id": next_id}
   753	        finally:
   754	            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)

