   379	def _regenerate_digest(lines: list[str]) -> list[str]:
   380	    """Regenerate the digest strictly between its markers, if present."""
   381
   382	    try:
   383	        begin = lines.index(DIGEST_BEGIN)
   384	        end = lines.index(DIGEST_END)
   385	    except ValueError:
   386	        return lines
   387	    if end < begin:
   388	        raise LedgerError("learnings_digest_markers_invalid", "digest end precedes begin")
   389	    doc = parse_text(_serialize(lines, True))
   390	    active = [e for e in sorted(doc.entries.values(), key=lambda e: e.entry_id) if not e.retired]
   391	    digest_lines = []
   392	    for entry in active[:DIGEST_MAX_ENTRIES]:
   393	        body = f"- [L{entry.entry_id}] {entry.text}"
   394	        if len(body) > DIGEST_MAX_LINE_CHARS:
   395	            body = body[: DIGEST_MAX_LINE_CHARS - 1] + "…"
   396	        digest_lines.append(body)
   397	    if len(active) > DIGEST_MAX_ENTRIES:
   398	        digest_lines.append(
   399	            f"- … {len(active) - DIGEST_MAX_ENTRIES} more active learnings (read the sections below)"
   400	        )
   401	    return lines[: begin + 1] + digest_lines + lines[end:]
